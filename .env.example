# LILI reads these environment variables. All are optional. In PowerShell set one with:  $env:LILI_VOICE = "Microsoft Zira Desktop"
LILI_HOME=            # where memory/models/browser profile live (default: ~/.lili)
LILI_MODEL=qwen3:4b   # Ollama model name (initial candidate, NOT benchmarked here)
LILI_HOST=http://127.0.0.1:11434
LILI_STT_MODEL=base.en   # faster-whisper model size; first use downloads it once
LILI_STT_DIR=            # or a local model folder for fully offline setup
LILI_STT_LANG=en
LILI_VOICE=              # exact SAPI voice name; empty = first installed female voice
LILI_RATE=0              # -10..10
LILI_VOLUME=100          # 0..100
LILI_HEADLESS=0          # 1 = hide the browser window
LILI_BROWSER_CHANNEL=    # e.g. chrome or msedge to use an installed browser instead of Playwright's Chromium
LILI_MAX_STEPS=12
LILI_MIN_TRAIN=200       # validated examples required before train-candidate will even start
LILI_BASE_HF=            # Hugging Face id of the SAME base model as LILI_MODEL (training only)
